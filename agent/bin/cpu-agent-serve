#!/bin/sh
# Headless OpenCode server for the CPU agent on 127.0.0.1:4096 (same environment as ~/.local/bin/agent).
# Started by `cpu-agent` as the systemd user unit cpu-agent-server; the TUI and the watchdog attach to it.
set -a; . "$HOME/.config/opencode/strata.env"; set +a
export OPENCODE_DISABLE_AUTOUPDATE=1 OPENCODE_DISABLE_MODELS_FETCH=1 OPENCODE_DISABLE_LSP_DOWNLOAD=1
export OPENCODE_ENABLE_EXA=1
export SUDO_ASKPASS="$HOME/.local/bin/agent-sudo-askpass"
export OPENCODE_DISABLE_PROJECT_CONFIG=1 OPENCODE_DISABLE_CLAUDE_CODE=1 OPENCODE_DISABLE_EXTERNAL_SKILLS=1
cd "$HOME/agent-workspace" || exit 1
exec "$HOME/.local/bin/opencode" serve --hostname 127.0.0.1 --port 4096
