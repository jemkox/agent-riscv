      "*> /home*": "allow",
      "*>/home*": "allow",
      "*>> /home*": "allow",
      "*>>/home*": "allow",
      "*> ..*": "allow",
      "*>..*": "allow",
      "*>> ..*": "allow",
      "*>>..*": "allow",
      "*> /*/*": "allow",
      "*>/*/*": "allow",
      "* 2>/dev/null": "allow",
      "* 2> /dev/null": "allow",
      "* >/dev/null": "allow",
      "* > /dev/null": "allow",
      "* >/dev/null 2>&1": "allow",
      "* > /dev/null 2>&1": "allow",
      "* &>/dev/null": "allow",
      "* 2>&1": "allow",
      "* 2>/dev/null || true": "allow",
      "* 2>/dev/null || :": "allow",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf ..*": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "fdisk *": "deny",
      "sfdisk *": "deny",
      "gdisk *": "deny",
      "parted *": "deny",
      "wipefs *": "deny",
      "mount *": "deny",
      "umount *": "deny",
      "losetup *": "deny",
      "cryptsetup *": "deny",
      "dislocker*": "deny",
      "efibootmgr *": "deny",
      "grub-*": "deny",
      "update-grub*": "deny",
      "* /etc/fstab*": "deny",
      "* /boot/*": "deny",
      "* /dev/sd*": "deny",
      "* /dev/nvme*": "deny",
      "*/etc/gshadow*": "deny",
      "*BitLocker*": "deny",
      "*bitlocker*": "deny",
      "*askpass*": "deny",
      "*ASKPASS*": "deny",
      "*zenity*": "deny",
      "*.ssh*": "deny",
      "*.gnupg*": "deny",
