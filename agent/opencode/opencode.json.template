      "*grub*": "deny",
      "*/dev/sd*": "deny",
      "*/dev/nvme*": "deny",
      "*.config/cpu-agent*": "deny",
      "*.config/opencode*": "deny",
      "* dd if=*": "deny",
      "* dd of=*": "deny",
      "*mkfs*": "deny",
      "*fdisk*": "deny",
      "*gdisk*": "deny",
      "*parted*": "deny",
      "*wipefs*": "deny",
      "*losetup*": "deny",
      "*cryptsetup*": "deny",
      "*dislocker*": "deny",
      "*efibootmgr*": "deny",
      "* mount *": "deny",
      "* mount": "deny",
      "*umount*": "deny",
      "*update-grub*": "deny",
      "*grub-install*": "deny",
      "*/etc/sudoers*": "deny",
      "*visudo*": "deny",
      "*/etc/pam.d*": "deny",
      "*passwd *": "deny",
      "*chpasswd*": "deny",
      "*usermod*": "deny"
    }
  }
}