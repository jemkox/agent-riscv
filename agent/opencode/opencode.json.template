{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/@MODEL_ID@",
  "small_model": "local/@MODEL_ID@",
  "autoupdate": false,
  "share": "disabled",
  "compaction": {
    "auto": true,
    "buffer": 40224
  },
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local model",
      "options": {
        "baseURL": "@MODEL_URL@/v1",
        "apiKey": "{env:MODEL_API_KEY}"
      },
      "models": {
        "@MODEL_ID@": {
          "name": "@MODEL_ID@ (local)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": @CONTEXT@,
            "input": @INPUT@,
            "output": 16384
          }
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "allow",
      "*.env.*": "allow",
      "*.env.example": "allow"
    },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "todowrite": "allow",
    "question": "allow",
    "task": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "allow",
    "external_directory": {
      "*": "allow",
      "~/agent-workspace/**": "allow",
            "/etc/**": "allow",
      "/media/**": "allow",
      "/mnt/**": "allow",
      "/etc": "allow",
      "/media": "allow",
      "/mnt": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.config/opencode/**": "deny",
      "~/.config/cpu-agent/**": "deny",
      "~/.claude/**": "deny",
      "/boot/**": "deny",
      "/dev/**": "deny",
      "~/.ssh": "deny",
      "~/.gnupg": "deny",
      "~/.config/opencode": "deny",
      "~/.config/cpu-agent": "deny",
      "~/.claude": "deny",
      "/boot": "deny",
      "/dev": "deny",
      "~/.local/bin/agent-sudo-askpass": "deny",
      "/etc/shadow": "deny",
      "/etc/gshadow": "deny",
      "/etc/fstab": "deny",
      "/etc/sudoers": "deny",
      "/etc/sudoers.d/**": "deny"
    },
    "bash": {
      "*": "allow",
      "ls": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "mkdir -p *": "allow",
      "touch *": "allow",
      "uniq": "allow",
      "uniq *": "allow",
      "sort": "allow",
      "sort *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "hdl *": "allow",
      "hdl": "allow",
      "true": "allow",
      "cd *": "allow",
      "echo *": "allow",
      "echo": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "tree *": "allow",
      "tree": "allow",
      "which *": "allow",
      "date": "allow",
      "whoami": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "chmod +x *": "allow",
      "chmod *+x*": "allow",
      "chmod 7*": "allow",
      "chmod 5*": "allow",
      "./downloads/*": "allow",
      "downloads/*": "allow",
      "sh *downloads/*": "allow",
      "bash *downloads/*": "allow",
      "python3 *downloads/*": "allow",
      "*.AppImage*": "allow",
      "*.run": "allow",
      "*.run *": "allow",
      "dpkg -i *": "allow",
      "*>*": "allow",
      "*$(*": "allow",
      "*`*": "allow",
      "*tee *": "allow",
      "*xargs *": "allow",
      "*eval *": "allow",
      "*bash -c*": "allow",
      "*sh -c*": "allow",
      "sudo -A apt update": "allow",
      "sudo -A apt-get update": "allow",
      "sudo -A apt install *": "allow",
      "sudo -A apt-get install *": "allow",
      "sudo -A *": "allow",
      "* sudo *": "allow",
      "*&& sudo *": "allow",
      "*;sudo *": "allow",
      "*| sudo *": "allow",
      "*|sudo *": "allow",
      "doas *": "allow",
      "pkexec *": "allow",
      "su": "allow",
      "su *": "allow",
      "sudo": "allow",
      "sudo *": "allow",
      "sudo -A apt* -o*": "allow",
      "sudo -A apt* -o=*": "allow",
      "sudo -A apt*--allow-unauthenticated*": "allow",
      "sudo -A apt*--config-file*": "allow",
      "sudo -A apt*--option*": "allow",
