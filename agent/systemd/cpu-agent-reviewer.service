[Unit]
Description=Independent reviewer: reviews the CPU builder's commits (at most hourly) and sends it fix lists
After=cpu-agent-server.service

[Service]
ExecStart=%h/.local/bin/review-at-commit --loop
Restart=on-failure
RestartSec=30
OOMPolicy=continue
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus

[Install]
WantedBy=default.target
