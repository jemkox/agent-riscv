[Unit]
Description=Watchdog: nudges the CPU agent when it stalls and sends progress notifications
After=cpu-agent-server.service

[Service]
ExecStart=%h/.local/bin/agent-watchdog
Restart=on-failure
RestartSec=30
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus

[Install]
WantedBy=default.target
