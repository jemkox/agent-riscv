# Minimal ISA for the rv32cpu (rv32ima_zicsr_zifencei, no F/D/V/C/Z*).
# NOTE: "# CONFIG_X is not set" lines in fragments are comments (they do NOT
# change anything); defconfigs may enable these symbols, so force-disable here.
# RISCV_ISA_C is also force-selected by CONFIG_EFI (default y with MMU+OF)!
CONFIG_EFI=n
CONFIG_RISCV_ISA_C=n
CONFIG_RISCV_ISA_V=n
CONFIG_RISCV_ISA_ZBB=n
CONFIG_RISCV_ISA_ZBA=n
CONFIG_RISCV_ISA_ZBC=n
CONFIG_RISCV_ISA_ZAWRS=n
CONFIG_RISCV_ISA_ZICBOM=n
CONFIG_RISCV_ISA_ZICBOZ=n
# CONFIG_FPU is not set
