# rv32cpu L7 fragment: Sv32 MMU kernel for the rv32cpu linux_sim machine
# (Sv32 paging, initramfs, ns16550 console; ISA kept minimal by linux-isa-min.config).
CONFIG_MMU=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_INITRAMFS_PRESERVE_MTIME=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_ALLOW_DEV_COREDUMP=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_VDSO=
# Keep the boot path cheap on the 10 MHz rv32cpu linux_sim machine.
CONFIG_FTRACE=n
CONFIG_TRACING=n
CONFIG_BUILTIN_TRACER_FUNCTIONS=n
CONFIG_KTRACER=n
CONFIG_FUNCTION_TRACER=n
CONFIG_DEBUG_VM_PGTABLE=
CONFIG_KASAN=
CONFIG_KGDB_KGDBTCONF=
CONFIG_LWTASKS=
CONFIG_TASKS_STAT=
